FROM python:3.11-slim
WORKDIR /app
COPY requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt
COPY automation_worker /app/automation_worker
RUN addgroup --system automation && adduser --system --ingroup automation --no-create-home automation
USER automation
CMD ["python", "-m", "automation_worker.runner"]
