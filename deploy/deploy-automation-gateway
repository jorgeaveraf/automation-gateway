#!/usr/bin/env bash
set -Eeuo pipefail

readonly APP_DIR=/root/automations/automation-gateway
readonly COMPOSE_FILE="$APP_DIR/docker-compose.production.yml"
readonly API_ENV="$APP_DIR/.env"
readonly WORKER_ENV="$APP_DIR/.env.worker"
readonly RELEASE_FILE="$APP_DIR/.release.env"
readonly LOCK_FILE=/run/lock/automation-gateway-deploy.lock
readonly API_REPO=ghcr.io/jorgeaveraf/automation-gateway
readonly WORKER_REPO=ghcr.io/jorgeaveraf/automation-worker

[[ $# -eq 1 && "$1" =~ ^[0-9a-f]{40}$ ]] || { echo "Usage: $0 <40-character-lowercase-git-sha>" >&2; exit 64; }
for binary in docker curl flock; do command -v "$binary" >/dev/null || exit 69; done
docker compose version >/dev/null
[[ -f "$API_ENV" && -f "$WORKER_ENV" ]] || { echo "Gateway .env and .env.worker are required" >&2; exit 66; }
[[ "$(stat -c '%a' "$API_ENV")" == 600 && "$(stat -c '%a' "$WORKER_ENV")" == 600 ]] || { echo "Environment files must have mode 600" >&2; exit 77; }
for key in AUTOMATION_GATEWAY_API_KEY REDIS_JOB_QUEUES; do
  grep -Eq "^$key=.+$" "$API_ENV" || { echo "Missing $key" >&2; exit 78; }
done
for key in QBO_GATEWAY_BASE_URL QBO_GATEWAY_API_KEY NOTIFICATION_LEDGER_URL NOTIFICATION_ROUTER_URL NOTIFICATION_ROUTER_API_KEY NOTIFICATION_SLACK_DESTINATION_ID; do
  grep -Eq "^$key=.+$" "$WORKER_ENV" || { echo "Missing $key" >&2; exit 78; }
done
grep -Eq '^NOTIFICATION_ROUTER_RULE_READY=true$' "$WORKER_ENV" || { echo "Notification rule readiness must be verified" >&2; exit 78; }

exec 9>"$LOCK_FILE"
flock -n 9 || { echo "Another Gateway deployment is running" >&2; exit 75; }
cd "$APP_DIR"
readonly target_api="$API_REPO:$1"
readonly target_worker="$WORKER_REPO:$1"
previous_api=""
previous_worker=""
if [[ -f "$RELEASE_FILE" ]]; then
  previous_api="$(sed -n 's/^AUTOMATION_IMAGE=//p' "$RELEASE_FILE" | head -n 1)"
  previous_worker="$(sed -n 's/^AUTOMATION_WORKER_IMAGE=//p' "$RELEASE_FILE" | head -n 1)"
fi
candidate_compose="$(mktemp "$APP_DIR/.compose.candidate.XXXXXX")"
candidate_release="$(mktemp "$APP_DIR/.release.candidate.XXXXXX")"
backup_compose="$(mktemp "$APP_DIR/.compose.previous.XXXXXX")"
had_compose=false
[[ -f "$COMPOSE_FILE" ]] && { cp "$COMPOSE_FILE" "$backup_compose"; had_compose=true; }
chmod 600 "$candidate_release"
printf 'AUTOMATION_IMAGE=%s\nAUTOMATION_WORKER_IMAGE=%s\n' "$target_api" "$target_worker" > "$candidate_release"

compose() {
  docker compose --project-directory "$APP_DIR" --env-file "$API_ENV" --env-file "$1" --file "$COMPOSE_FILE" "${@:2}"
}
healthy() {
  local deadline=$((SECONDS + 120))
  while (( SECONDS < deadline )); do
    [[ "$(docker inspect -f '{{if .State.Health}}{{.State.Health.Status}}{{end}}' automation-gateway-v2 2>/dev/null || true)" == healthy ]] &&
      [[ "$(docker inspect -f '{{if .State.Running}}running{{end}}' automation-gateway-v2 2>/dev/null || true)" == running ]] &&
      [[ "$(compose "$1" ps --status running --services | grep -Ec '^(redis|automation-worker)$')" == 2 ]] &&
      curl --fail --silent --max-time 3 http://127.0.0.1:8003/health >/dev/null && return 0
    sleep 2
  done
  return 1
}
rollback() {
  echo "Gateway v2 candidate failed; restoring previous release" >&2
  if "$had_compose"; then cp "$backup_compose" "$COMPOSE_FILE"; else rm -f "$COMPOSE_FILE"; fi
  if [[ "$previous_api" =~ ^$API_REPO:[0-9a-f]{40}$ && "$previous_worker" =~ ^$WORKER_REPO:[0-9a-f]{40}$ ]]; then
    compose "$RELEASE_FILE" up -d --force-recreate redis automation-gateway automation-worker || true
    healthy "$RELEASE_FILE" || echo "Rollback needs operator attention" >&2
  else
    # This is a separate Compose project. Never touch the old Gateway or its network.
    docker compose --project-directory "$APP_DIR" --env-file "$API_ENV" --env-file "$candidate_release" --file "$candidate_compose" down --remove-orphans || true
  fi
}
cleanup() { rm -f "$candidate_compose" "$candidate_release" "$backup_compose"; }
trap cleanup EXIT

docker pull "$target_api"
docker pull "$target_worker"
image_container="$(docker create "$target_api")"
trap 'docker rm -f "$image_container" >/dev/null 2>&1 || true; cleanup' EXIT
docker cp "$image_container:/app/deploy/docker-compose.production.yml" "$candidate_compose"
docker rm "$image_container" >/dev/null
trap cleanup EXIT
grep -Eq '^name: automation-gateway-v2$' "$candidate_compose" || { echo "Unexpected Compose project" >&2; exit 78; }
if "$had_compose" && [[ ! -f "$APP_DIR/docker-compose.legacy.yml" ]]; then
  install -m 644 "$backup_compose" "$APP_DIR/docker-compose.legacy.yml"
  if [[ -f "$RELEASE_FILE" ]]; then
    install -m 600 "$RELEASE_FILE" "$APP_DIR/.release.legacy.env"
  fi
fi
cp "$candidate_compose" "$COMPOSE_FILE"
if ! compose "$candidate_release" config --quiet ||
   ! compose "$candidate_release" up -d --force-recreate redis automation-gateway automation-worker ||
   ! healthy "$candidate_release"; then
  rollback
  exit 70
fi
mv "$candidate_release" "$RELEASE_FILE"
echo "Gateway v2 deployed: $target_api and $target_worker"
