APP_NAME=Automation Gateway
APP_VERSION=0.1.0
LOG_LEVEL=INFO

# Required inbound service credential used by Airflow.
AUTOMATION_GATEWAY_API_KEY=

# Redis connection and configurable job-kind to Redis List routing.
REDIS_URL=redis://redis:6379/0
REDIS_JOB_QUEUES={"qbo.connection_checked.v1":"automation:jobs:qbo.connection_checked.v1"}
JOB_DEDUPLICATION_TTL_SECONDS=2592000
