APP_NAME=Automation Gateway
APP_VERSION=0.1.0
LOG_LEVEL=INFO

# Required inbound service credential used by Airflow.
AUTOMATION_GATEWAY_API_KEY=

# Required QBO Gateway endpoint and admin credential.
QBO_GATEWAY_BASE_URL=http://host.docker.internal:8000
QBO_GATEWAY_API_KEY=
QBO_GATEWAY_TIMEOUT_SECONDS=10
