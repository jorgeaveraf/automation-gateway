APP_NAME=Automation Gateway
APP_VERSION=0.1.0
LOG_LEVEL=INFO
AUTOMATION_GATEWAY_API_KEY=replace-with-a-local-secret
REDIS_URL=redis://redis:6379/0
REDIS_JOB_QUEUES={"qbo.connection_checked.v1":"automation:jobs:qbo.connection_checked.v1"}
JOB_DEDUPLICATION_TTL_SECONDS=2592000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
